# Cachés y temporales
__pycache__/
*.pyc
.venv/
venv/

# Caché de descargas para los experimentos: se regenera solo y pesa 1,4 MB
datos/understat_historico.csv

# Salidas de los renderizados de Quarto
*_files/
*.quarto_ipynb
.quarto/

# Historial de RStudio
.Rhistory

# ── Trabajo de investigación, fuera del repositorio público ──────────────
# Todo esto sigue en el computador; simplemente no se publica, para que quien
# entre al repositorio vea sólo lo que hace funcionar la página.
datos/*
manutd-2526.*
web/datos_modelo.json
scripts/descargar_fbref.py
scripts/dixon_coles.py
scripts/dixon_coles_xg.py
scripts/evaluar_*.py
scripts/experimento_*.py
scripts/explicar_prediccion.py
scripts/exportar_web.py
scripts/generar_ligas.py

# Herramienta local para subir con doble clic
subir.bat

# La caché de fotos sí se publica: sin ella, cada actualización automática
# tendría que volver a consultar los 768 jugadores desde cero.
!datos/fotos_jugadores.json
!datos/escudos.json
!datos/estadios.json
!datos/football_data_historial.json
!datos/football_data.json
# Los escudos de football-data.org se recogen de los partidos que ya se bajan,
# así que en una ejecución con la caché de partidos caliente no se recoge
# ninguno. Sin publicar esta lista, la actualización automática dejaba a la
# Championship y a la Champions sin escudos.
!datos/football_data_equipos.json
!datos/escudos_wikidata.json
# El registro de pronósticos se publica a propósito: su valor está en que
# cualquiera pueda comprobar en el historial que no se ha retocado.
!datos/pronosticos.json
!datos/logos_competiciones.json
# La biblioteca de vídeos se acumula ejecución a ejecución: el RSS sólo da los
# quince últimos de cada canal, así que si no se guarda no hay biblioteca.
!datos/videos.json
!datos/fotos_fallidas.json
